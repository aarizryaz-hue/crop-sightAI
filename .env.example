# Copy to .env and enter your key locally. Never commit .env or share the key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Existing terminal environment variables override .env values.
# AI_BASE_URL=https://api.openai.com/v1
# HOST=127.0.0.1
# PORT=3000
# Required before a Play Store release: real publisher identity and privacy contact.
# APP_DEVELOPER_NAME=
# APP_CONTACT_EMAIL=
# Private persistent storage for user-submitted reports. Do not serve this folder publicly.
# REPORTS_DIR=/absolute/path/on/persistent-storage/cropsight-reports
